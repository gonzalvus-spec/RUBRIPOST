{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RubriPost",
  "version": "0.1.9",
  "identifier": "com.Rubrifact.rubripost",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RubriPost",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "dragDropEnabled": false,
        "center": true,
        "transparent": false,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5NjIxRDE0M0E2RkY5ODAKUldTQStXODZGQjFpaWV0UGNydFg2emtqYk9ZWWFTSTVHVE42SWpPNzFvTk9WNGNwc2FPUjVtVDEK",
      "endpoints": [
        "https://github.com/gonzalvus-spec/RUBRIPOST/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
