# =============================================================================
# RUBRIFACT API CLIENT — variables de entorno
# Copia este archivo como `.env` y completa los valores reales.
# =============================================================================

# URI de conexión a MongoDB (Atlas o instancia local).
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Base de datos donde se guardan las requests.
MONGODB_DB=rubripost_db

# EID del workspace. Debe ser el mismo en todas las PCs conectadas a la misma
# MongoDB para que compartan las mismas colecciones y requests.
VITE_RUBRI_EID=EMP-0042

# Para trabajar en 2 PCs a la vez, MONGODB_URI debe apuntar a un MongoDB
# compartido (Atlas o un servidor LAN), no a 127.0.0.1.

# Clave maestra usada para cifrar tokens/API keys con AES-256-GCM antes de
# escribirlos en MongoDB. Usa una cadena larga y aleatoria y NO la cambies sin
# volver a guardar las requests (los secretos existentes no podrían descifrarse).
RUBRIPOST_AUTH_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Opcional: token de Rubri Systems que el botón ".env" cargará en la pestaña
# Auth. Nunca se hardcodea en el código fuente.
# VITE_RUBRI_TOKEN=eyJ0eXAiOiJKV1Qi...
